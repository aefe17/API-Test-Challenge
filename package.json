{
  "name": "api-test-challenge",
  "version": "1.0.0",
  "description": "API test automation with TypeScript, Vitest and Axios",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env API/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env API/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "selfsigned": "^5.5.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3"
  }
}
